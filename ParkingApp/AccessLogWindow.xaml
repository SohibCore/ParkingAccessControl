<Window x:Class="ParkingApp.AccessLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kirish-chiqish tarixi" Height="500" Width="700"
        Background="#0F172A">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kirish-chiqish tarixi"
                   FontSize="20" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,15"/>

        <DataGrid x:Name="LogsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1E293B" Foreground="#F1F5F9"
                  BorderBrush="#334155" BorderThickness="1"
                  RowBackground="#1E293B" AlternatingRowBackground="#243248"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" SelectionChanged="LogsDataGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mashina raqami" Binding="{Binding CarNumber}" Width="*"/>
                <DataGridTextColumn Header="Rezident" Binding="{Binding Apartment}" Width="*"/>
                <DataGridTextColumn Header="Kirish vaqti" Binding="{Binding EntryTime}" Width="*"/>
                <DataGridTextColumn Header="Chiqish vaqti" Binding="{Binding ExitTime}" Width="*"/>
                <DataGridTextColumn Header="Davomiyligi" Binding="{Binding Duration}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="O'chirish" Click="DeleteButton_Click"
        VerticalAlignment="Center" Width="100"
        HorizontalAlignment="Right" Background="#EF4444" Height="24"  />

    </Grid>
</Window>