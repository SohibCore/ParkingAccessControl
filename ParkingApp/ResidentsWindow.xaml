<Window x:Class="ParkingApp.ResidentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rezidentlarni boshqarish" Height="500" Width="500"
        Background="#0F172A">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="F.I.Sh:"/>
            <TextBox x:Name="FullNameBox" Margin="0,2,0,8"/>

            <TextBlock Text="Xonadon raqami:"/>
            <TextBox x:Name="ApartmentBox" Margin="0,2,0,8"/>

            <TextBlock Text="Mashina raqami:"/>
            <TextBox x:Name="PlateBox" Margin="0,2,0,8"/>

            <Button Content="Qo'shish" Click="AddButton_Click" Margin="0,5,0,0"
                    Width="100" HorizontalAlignment="Left" Background="#10B981"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Ro'yxat:" FontWeight="Bold"
                    Foreground="#F1F5F9" Margin="0,15,0,5"/>

        <DataGrid x:Name="ResidentsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1E293B" Foreground="#F1F5F9"
                  BorderBrush="#334155" BorderThickness="1"
                  RowBackground="#1E293B" AlternatingRowBackground="#243248"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ism" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Xonadon" Binding="{Binding Apartment}" Width="100"/>
                <DataGridTextColumn Header="Mashina raqami" Binding="{Binding CarNumber}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Tanlanganini o'chirish" Click="DeleteButton_Click" Grid.Row="2"
                VerticalAlignment="Bottom" Margin="0,0,0,-40" Width="180"
                HorizontalAlignment="Left" Background="#EF4444"/>
    </Grid>
</Window>