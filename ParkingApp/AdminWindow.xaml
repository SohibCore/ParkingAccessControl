<Window x:Class="ParkingApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParkingApp"
        mc:Ignorable="d"
        Title="Parking Access Control" Height="700" Width="900"
        Background="#0F172A">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sarlavha -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🅿️" FontSize="26" Margin="0,0,10,0"/>
                <TextBlock Text="Parking Access Control"
                           FontSize="24" FontWeight="Bold" Foreground="#F1F5F9"/>
            </StackPanel>
            <TextBlock Text="Admin panel" FontSize="13" Foreground="#94A3B8"
                       Margin="36,2,0,0"/>
        </StackPanel>

        <!-- Boshqaruv tugmalari -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,15">
            <Button x:Name="StartCameraButton" Content="▶  Kamerani ishga tushirish"
                    Click="StartEntryCameraButton_Click" Background="#10B981" Width="202"/>
            <Button x:Name="StopCameraButton" Content="⏹  To'xtatish"
                    Margin="10,0,0,0" Click="StopCameraButton_Click"
                    IsEnabled="False" Background="#EF4444"/>

            <Button Content="▶  Chiqish kamerasi"
            Click="StartExitCameraButton_Click" Margin="20,0,0,0" Background="#10B981"/>

            <Button Content="👥  Rezidentlarni boshqarish"
                    Click="AdminButton_Click" Margin="10,0,0,0" Background="#334155" Width="215"/>
            <Button Content="📋 Tarix"
                    Click="ShowAccessLogButton_Click" Margin="5,0,0,0" Background="#334155" Width="100"/>
        </StackPanel>

        <!-- Natija paneli -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8"
                BorderBrush="#334155" BorderThickness="1" Padding="16,12" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Aniqlangan raqam:" FontSize="14" Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="PlateTextBlock" VerticalAlignment="Center"
                           FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" Margin="8,0,0,0"/>
                <TextBlock x:Name="MyTextBlock" Text="" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="StatusTextBlock" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#F1F5F9"/>
            </StackPanel>
        </Border>

        <!-- Kamera ko'rinishi -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kirish kamerasi -->
            <Border Grid.Column="0" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Background="Black" Margin="0,0,5,0">
                <Grid>
                    <Image x:Name="EntryCameraView" Stretch="Uniform"/>
                    <TextBlock Text="KIRISH KAMERASI" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Chiqish kamerasi -->
            <Border Grid.Column="1" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Background="Black" Margin="5,0,0,0">
                <Grid>
                    <Image x:Name="ExitCameraView" Stretch="Uniform"/>
                    <TextBlock Text="CHIQISH KAMERASI" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <!-- Diagnostika -->
        <UniformGrid Grid.Row="4" Rows="1" Columns="3" Margin="0,15,0,0">
            <Border Background="#1E293B" CornerRadius="8" Margin="0,0,5,0" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚗" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <StackPanel>
                        <TextBlock x:Name="TodayEntryText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Bugungi kirishlar" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#1E293B" CornerRadius="8" Margin="5,0,5,0" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚙" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <StackPanel>
                        <TextBlock x:Name="TodayExitText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Bugungi chiqishlar" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#1E293B" CornerRadius="8" Margin="5,0,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <StackPanel>
                        <TextBlock x:Name="TotalResidentsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Jami rezidentlar" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Window>